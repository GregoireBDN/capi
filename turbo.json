{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["generate", "^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**", "dist/**"]
    },
    "generate": {
      "dependsOn": ["^generate"],
      "inputs": ["src/**/*.ts", "openapi.json", "openapi-ts.config.ts"],
      "outputs": ["openapi.json", "src/api/**"]
    },
    "@capi/web#generate": {
      "dependsOn": ["@capi/api#generate"],
      "inputs": ["openapi.json", "openapi-ts.config.ts"],
      "outputs": ["src/api/**"]
    },
    "@capi/mcp#generate": {
      "dependsOn": ["@capi/api#generate"],
      "inputs": ["openapi.json", "openapi-ts.config.ts"],
      "outputs": ["src/api/generated/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["generate", "^lint"]
    },
    "check-types": {
      "dependsOn": ["generate", "^check-types"]
    },
    "format": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@capi/web#build": {
      "dependsOn": ["generate", "^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "../../skills/capi/**"],
      "outputs": [".output/**", "dist/**"]
    },
    "@capi/mcp#build": {
      "dependsOn": ["generate", "^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "../../skills/capi/**"],
      "outputs": ["dist/**"]
    },
    "@capi/mcp#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../skills/capi/**"]
    }
  }
}
