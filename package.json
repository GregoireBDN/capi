{
  "name": "capi",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "turbo format",
    "test": "turbo test",
    "check-types": "turbo check-types",
    "generate": "turbo run generate",
    "db:generate": "pnpm --filter @capi/api db:generate",
    "db:migrate": "pnpm --filter @capi/api db:migrate",
    "db:studio": "pnpm --filter @capi/api db:studio",
    "db:seed": "pnpm --filter @capi/api db:seed",
    "db:demo": "pnpm --filter @capi/api db:demo"
  },
  "devDependencies": {
    "lint-staged": "^16.0.0",
    "prettier": "^3.8.1",
    "turbo": "^2.5.4",
    "typescript": "^6.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "@nestjs/core"
    ],
    "overrides": {
      "@hono/node-server": "2.1.5",
      "brace-expansion@5": "5.0.12",
      "browserslist": "4.28.7",
      "encodeurl": "2.0.1",
      "express-rate-limit": "8.7.2",
      "fast-uri@3": "3.1.9",
      "fastify": "5.12.6",
      "find-my-way@9": "9.7.0",
      "hono": "4.13.14",
      "ip-address": "10.7.5",
      "jose": "6.2.14",
      "js-yaml@4": "4.3.2",
      "nanoid@3": "3.3.18",
      "postcss@8": "8.5.23",
      "seroval": "1.6.8",
      "seroval-plugins": "1.6.8",
      "source-map-js@1": "1.2.2"
    }
  }
}
