# Pull request previews (#599, docs/runbooks/previews.md): one sync of the
# previews with the open pull requests. Started by capi-previews.timer.
# Install: sudo cp deploy/systemd/capi-previews.* /etc/systemd/system/ &&
#          sudo systemctl daemon-reload && sudo systemctl enable --now capi-previews.timer
[Unit]
Description=Capi pull request previews: sync with the open pull requests
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/srv/capi-previews/preview.sh

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/capi-previews
ExecStart=/srv/capi-previews/preview.sh sync
# A deploy pulls images and seeds a database: a few minutes at most.
TimeoutStartSec=20min
Nice=10
