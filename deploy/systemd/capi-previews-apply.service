# Pull request previews (#608, docs/runbooks/previews.md): applies the
# settings asked from the panel (look, demo sign-in, fresh demo data), without
# calling GitHub. Started by capi-previews-apply.path when a request is written.
[Unit]
Description=Capi pull request previews: apply the panel's settings
After=docker.service
ConditionPathExists=/srv/capi-previews/preview.sh

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/capi-previews
ExecStart=/srv/capi-previews/preview.sh apply
# A demo data reset takes a minute at most.
TimeoutStartSec=10min
Nice=10
