# Origin of the API as reached from the web server, read at runtime (not baked
# into the client bundle). The web server proxies /api/* there and uses it for
# SSR calls; the browser always calls the relative /api on the web origin.
# Defaults to http://localhost:4000 when unset. Set it in the shell/container
# environment, e.g. `API_URL=http://localhost:4100 pnpm --filter @finances/web dev`.
API_URL=http://localhost:4000
