# Origin of the API as reached from the web server, read at runtime (not baked
# into the client bundle). The web server proxies /api/* there and uses it for
# SSR calls; the browser always calls the relative /api on the web origin.
# Defaults to http://localhost:4000 when unset. Set it in the shell/container
# environment, e.g. `API_URL=http://localhost:4100 pnpm --filter @finances/web dev`.
API_URL=http://localhost:4000

# Peers allowed to set the client IP through X-Forwarded-For (Caddy in
# production): IPs, CIDR ranges, loopback, linklocal, uniquelocal, or none.
# Other peers get their socket address, so a client cannot pick the IP the
# API rate-limits. Defaults to loopback,uniquelocal; narrow it to the `proxy`
# network's subnet in production if other containers share that network.
TRUSTED_PROXIES=loopback,uniquelocal

# Deployment shown on screen (#454): `staging` gives the header, icons and
# manifest staging's yellow look (set by docker-compose.staging.yml). Unset or
# anything else is production.
# APP_ENVIRONMENT=staging
