DATABASE_URL=postgres://user:password@localhost:5432/finances

# Required in production. Leave commented out in dev to use an ephemeral
# per-boot secret (an empty value fails validation).
# JWT_SECRET=
APP_URL=http://localhost:3000

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=noreply@finances.app


# Crypto prices: CoinGecko public API (no key). Only asset ids are sent, never
# quantities or values. Set PRICE_API_ENABLED=false to use manual prices only.
PRICE_API_ENABLED=true
PRICE_API_URL=https://api.coingecko.com/api/v3
PRICE_CACHE_TTL_SECONDS=600
