DATABASE_URL=postgres://user:password@localhost:5432/finances

# Required in production. Leave commented out in dev to use an ephemeral
# per-boot secret (an empty value fails validation).
# JWT_SECRET=
APP_URL=http://localhost:3000

# Passkeys (WebAuthn): relying party id and expected origin. Empty = APP_URL's
# host name (`localhost`, which browsers accept over plain HTTP) and origin.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# Peers allowed to set the client IP through X-Forwarded-For (the web server's
# /api proxy): IPs, CIDR ranges, loopback, linklocal, uniquelocal, or none.
# The default trusts localhost (dev) and private Docker ranges (production),
# which is only safe while the API port is not published.
TRUSTED_PROXIES=loopback,uniquelocal

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=noreply@finances.app


# Crypto prices: CoinGecko public API (no key). Only asset ids are sent, never
# quantities or values. Set PRICE_API_ENABLED=false to use manual prices only.
PRICE_API_ENABLED=true
PRICE_API_URL=https://api.coingecko.com/api/v3
PRICE_CACHE_TTL_SECONDS=600

# --- Wallet sync (#129, ADR 0002) -------------------------------------------
# Reads wallet accounts from their public keys: Bitcoin addresses (derived
# from the xpub / ypub / zpub on the server) go to the Esplora API, EVM
# addresses and token contracts to the JSON-RPC endpoints, which can then link
# this server's IP to the wallets. Off by default: nothing is sent and wallet
# accounts are filled by hand. Self-host Esplora or a node to keep it private.
WALLET_SYNC_ENABLED=false
ESPLORA_URL=https://mempool.space/api
# JSON object of RPC URLs keyed by chain id, overriding the public defaults
# (publicnode.com); "" turns a chain off. Chain ids: 1 Ethereum, 42161
# Arbitrum, 8453 Base, 10 Optimism, 137 Polygon, 56 BNB Chain.
EVM_RPC_URLS=
WALLET_SYNC_TIMEOUT_MS=10000
WALLET_SYNC_INTERVAL_SECONDS=600
