    "zod": "4.4.3"
  },
  "devDependencies": {
    "@finances/config-typescript": "workspace:*",
    "@hey-api/openapi-ts": "0.97.1",
    "@types/node": "22.19.19",
    "eslint": "9.39.4",
    "tsx": "4.22.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.3",
    "vitest": "4.1.6"
  }
}
