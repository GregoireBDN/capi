{
  "name": "@finances/mcp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "finances-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
