# Production environment for docker-compose.prod.yml.
#
# On the server this file is /srv/finances/.env, owned by the `deploy` user,
# mode 600 (see docs/runbooks/production-stack.md and docs/runbooks/deploy.md).
# Never commit the real file. Required values are left empty on purpose:
# `docker compose` refuses to start until they are set.
#
# Generate secrets on the server, never reuse them elsewhere, and keep a copy in
# the password manager:
#   openssl rand -hex 32

# --- Release ---------------------------------------------------------------
# Image tag of ghcr.io/gregoirebdn/finances-{api,web}: vX.Y.Z or sha-<shortsha>.
# Rewritten by the deploy script on each deploy.
FINANCES_VERSION=

# --- Database (own Postgres container, never published) --------------------
POSTGRES_DB=finances
POSTGRES_USER=finances
# Goes into DATABASE_URL: use URL-safe characters (hex is). Only read when the
# volume is first initialised; changing it later needs ALTER USER in Postgres.
POSTGRES_PASSWORD=

# --- API -------------------------------------------------------------------
# Signs the session JWTs. Changing it signs everyone out. At least 32
# characters, or the API refuses to start: `openssl rand -hex 32`.
JWT_SECRET=
# Public web origin: email links, the CORS origin and passkeys.
APP_URL=https://finances.gbodin.cloud

# Passkeys (WebAuthn, #100). Leave empty: the relying party id is APP_URL's
# host name and the expected origin is APP_URL's origin. Set them only if the
# app is reached on another origin. WEBAUTHN_RP_ID must be that origin's host
# or a parent domain of it, or the API refuses to start. Changing the RP id
# later makes every registered passkey unusable (the password still works).
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# Peers allowed to set the client IP through X-Forwarded-For (#49): IPs, CIDR
# ranges, loopback, linklocal, uniquelocal or none.
# - TRUSTED_PROXIES, for `api`: `web` on the project network, which only
#   `web` and `db` join. The default trusts the private ranges Docker uses.
# - WEB_TRUSTED_PROXIES, for `web`: Caddy only, by its service name on the
#   shared `proxy` network (host names are resolved through Docker's DNS every
#   30 s), so another app's container on `proxy` can't choose its client IP
#   (#183). Fallback if Caddy is renamed and the name no longer resolves (the
#   web logs then say `Trusted proxy "caddy" does not resolve`): the new name,
#   or `uniquelocal` (any private address, the behaviour before #183).
TRUSTED_PROXIES=loopback,uniquelocal
WEB_TRUSTED_PROXIES=caddy

# Memory limit of each of the `api` and `web` containers (#183), without
# swap. Node sizes its heap from it. Raise it if one restarts with exit 137.
APP_MEM_LIMIT=512m

# --- Email (optional) ------------------------------------------------------
# Without SMTP_HOST no email is sent (sign-up verification and password reset
# emails are skipped) and /api/health does not check SMTP. When it is set,
# /api/health fails while the SMTP server is unreachable, which marks the API
# unhealthy and makes a deploy roll back.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@finances.app

# --- Crypto prices ---------------------------------------------------------
# CoinGecko public API, key-less; only asset ids are sent. Set
# PRICE_API_ENABLED=false to use manual prices only.
PRICE_API_ENABLED=true
PRICE_API_URL=https://api.coingecko.com/api/v3
PRICE_CACHE_TTL_SECONDS=600

# --- Wallet sync (#129, ADR 0002) -------------------------------------------
# Reads wallet accounts from their public keys: Bitcoin addresses (derived
# from the xpub / ypub / zpub on the server) go to the Esplora API, EVM
# addresses and token contracts to the JSON-RPC endpoints, which can then link
# this server's IP to the wallets. Off by default: nothing is sent and wallet
# accounts are filled by hand (the app says so when a wallet is set up). Self-
# host Esplora or a node to keep it private. Turning it on: see
# docs/runbooks/production-stack.md (Wallet sync).
WALLET_SYNC_ENABLED=false
ESPLORA_URL=https://mempool.space/api
# Minimum spacing of Esplora requests: 1 per second suits mempool.space's
# public API; lower it for a self-hosted Esplora.
ESPLORA_MIN_INTERVAL_MS=1000
# JSON object of RPC URLs keyed by chain id, overriding the public defaults
# (publicnode.com); "" turns a chain off. Chain ids: 1 Ethereum, 42161
# Arbitrum, 8453 Base, 10 Optimism, 137 Polygon, 56 BNB Chain.
EVM_RPC_URLS=
WALLET_SYNC_TIMEOUT_MS=10000
WALLET_SYNC_INTERVAL_SECONDS=600

# --- Remote MCP access (#78, ADR 0003) ---------------------------------------
# OAuth server for the claude.ai / Claude app connectors. Keep it off until
# the #102 findings are fixed and the adapter, Caddy route and public DNS
# exist (docs/runbooks/remote-mcp.md). Off: no /api/oauth route, OAuth tokens
# refused (kill switch).
REMOTE_MCP_ENABLED=false
# Public origin of the MCP adapter (https): the OAuth issuer; MCP at <origin>/mcp.
REMOTE_MCP_PUBLIC_URL=
# Allowed redirect URIs (comma-separated, exact). Empty = claude.ai / claude.com.
REMOTE_MCP_REDIRECT_URIS=
