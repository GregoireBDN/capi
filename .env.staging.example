# Staging environment (#421) for docker-compose.prod.yml + docker-compose.staging.yml.
#
# On the server this file is /srv/capi-staging/.env, owned by the `deploy`
# user, mode 600 (see docs/runbooks/staging.md). Never commit the real file.
# Every secret here is staging's own: never copy one from /srv/capi/.env.
#   openssl rand -hex 32
#
# Staging only ever holds the demo data, wiped and seeded again on each
# deploy. The database name, SMTP, remote MCP, prices and wallet sync are
# fixed by docker-compose.staging.yml, not here, and so is the web service's
# APP_ENVIRONMENT=staging (#454: yellow header, icons and its own manifest, so
# staging is never taken for production on the phone).

# --- Release ---------------------------------------------------------------
# Image tag sha-<commit>, rewritten by deploy.sh --staging on each deploy.
CAPI_VERSION=

# --- Database (own volume, never published) --------------------------------
# The volume keeps the name the `finances-staging` project gave it before
# #464's step B (docs/runbooks/rename.md). Required: deploy.sh and compose
# refuse to run without it.
DB_VOLUME=finances-staging_db_data
POSTGRES_USER=finances
# URL-safe (hex), staging's own.
POSTGRES_PASSWORD=
# The API's own database role `capi_app` (#557): neither superuser nor the
# tables' owner, so row-level security holds for it. deploy.sh writes one
# (64 hex characters) when missing; the `migrate` service sets it on the role
# at every deploy, so changing it only takes a deploy.
APP_DB_PASSWORD=

# --- API -------------------------------------------------------------------
# Staging's own, at least 32 characters: a production session is never valid here.
JWT_SECRET=
# Staging's own host on the tailnet (Caddy, infra repo → capi-staging-web:3000).
# Its own origin keeps the session cookies (__Host-) and passkeys apart from production.
APP_URL=https://capi-staging.gbodin.cloud
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# Same meaning as in production (.env.production.example).
TRUSTED_PROXIES=loopback,uniquelocal
WEB_TRUSTED_PROXIES=caddy

# Smaller than production: staging shares the server with it.
APP_MEM_LIMIT=384m

# Never set on staging: deploy.sh --staging refuses the remote MCP adapter.
COMPOSE_PROFILES=
